# Copy to a protected environment file or map these values from a secret manager.
# Load the same settings in the NetBox web process and every backup worker.

# AES-256-GCM key for credentials stored through the NetBox UI.
NETBOX_CONFIG_BACKUP_MASTER_KEY=
NETBOX_CONFIG_BACKUP_MASTER_KEY_VERSION=1
# Temporary JSON keyring used only during rotation, for example:
# {"1":"OLD_BASE64URL_KEY"}. Remove old entries after every credential has
# been verified on the active version and the rollback window has ended.
NETBOX_CONFIG_BACKUP_PREVIOUS_MASTER_KEYS={}

NETBOX_CONFIG_BACKUP_EVENTS_ENABLED=true
NETBOX_CONFIG_BACKUP_NOTIFY_ON_EVERY_FAILURE=false
NETBOX_CONFIG_BACKUP_METRICS_ENABLED=false
NETBOX_CONFIG_BACKUP_NAS_ENABLED=false
NETBOX_CONFIG_BACKUP_NAS_STATUS_PATH=/var/lib/netbox-config-backup/nas-backup/last-success.json
NETBOX_CONFIG_BACKUP_NAS_STALE_HOURS=48

# Local remains the safe default. Change to s3 only after a successful migration.
NETBOX_CONFIG_BACKUP_STORAGE_BACKEND=local

# Temporary verified ZIPs prepared manually from successful FTP replicas.
NETBOX_CONFIG_BACKUP_RECOVERY_PACKAGE_TTL_MINUTES=60
NETBOX_CONFIG_BACKUP_RECOVERY_PACKAGE_MAX_BYTES=1073741824

# HashiCorp Vault KV v2. Keep AppRole material out of Git and the NetBox database.
NETBOX_CONFIG_BACKUP_VAULT_ENABLED=false
VAULT_ADDR=https://vault.example.com:8200
VAULT_NAMESPACE=
NETBOX_CONFIG_BACKUP_VAULT_AUTH_METHOD=approle
NETBOX_CONFIG_BACKUP_VAULT_AUTH_MOUNT_POINT=approle
NETBOX_CONFIG_BACKUP_VAULT_ROLE_ID=
NETBOX_CONFIG_BACKUP_VAULT_SECRET_ID=
NETBOX_CONFIG_BACKUP_VAULT_VERIFY_TLS=true
NETBOX_CONFIG_BACKUP_VAULT_CA_BUNDLE=
NETBOX_CONFIG_BACKUP_VAULT_ALLOW_INSECURE_HTTP=false
NETBOX_CONFIG_BACKUP_VAULT_TIMEOUT=10

# S3/S3-compatible storage. Prefer an IAM role/workload identity to static keys.
NETBOX_CONFIG_BACKUP_S3_BUCKET=
NETBOX_CONFIG_BACKUP_S3_PREFIX=netbox-config-backup
NETBOX_CONFIG_BACKUP_S3_REGION=
NETBOX_CONFIG_BACKUP_S3_ENDPOINT_URL=
NETBOX_CONFIG_BACKUP_S3_ADDRESSING_STYLE=auto
NETBOX_CONFIG_BACKUP_S3_VERIFY_TLS=true
NETBOX_CONFIG_BACKUP_S3_CA_BUNDLE=
NETBOX_CONFIG_BACKUP_S3_ALLOW_INSECURE_HTTP=false
NETBOX_CONFIG_BACKUP_S3_SERVER_SIDE_ENCRYPTION=AES256
NETBOX_CONFIG_BACKUP_S3_KMS_KEY_ID=
NETBOX_CONFIG_BACKUP_S3_REQUEST_TIMEOUT=30
NETBOX_CONFIG_BACKUP_S3_MAX_OBJECT_BYTES=1073741824
