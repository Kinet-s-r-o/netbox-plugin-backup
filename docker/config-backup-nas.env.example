# Keep this file outside Git. The repository password is the recovery key for
# PostgreSQL, configuration artifacts, receiver keys, and the plugin master key.
RESTIC_REPOSITORY=s3:https://nas.example.com/netbox-backups
RESTIC_PASSWORD=
RESTIC_AUTO_INIT=false

# S3-compatible NAS credentials. Omit these for a REST server or workload identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RUN_ON_START=true
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
NAS_BACKUP_HEALTH_MAX_AGE_SECONDS=172800
