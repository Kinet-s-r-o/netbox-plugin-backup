ARG NETBOX_IMAGE=netboxcommunity/netbox:v4.6-5.0.2
FROM ${NETBOX_IMAGE} AS plugin-builder

# Build the same immutable wheel used by traditional NetBox installations.
COPY pyproject.toml README.md /tmp/netbox-config-backup/
COPY netbox_config_backup /tmp/netbox-config-backup/netbox_config_backup
RUN /usr/local/bin/uv build --wheel \
      --out-dir /tmp/netbox-config-backup-dist \
      /tmp/netbox-config-backup

FROM ${NETBOX_IMAGE}

COPY --from=plugin-builder /tmp/netbox-config-backup-dist/ /tmp/netbox-config-backup-dist/

RUN /usr/local/bin/uv pip install --no-cache \
      --python /opt/netbox/venv/bin/python \
      /tmp/netbox-config-backup-dist/*.whl \
    && rm -rf /tmp/netbox-config-backup-dist \
    && install -d -o netbox -g root -m 0700 /var/lib/netbox-config-backup
